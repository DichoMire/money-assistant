# --- Database (Neon / Vercel Postgres) ---
# On Vercel: add the Neon integration from the Marketplace; it sets DATABASE_URL
# (or POSTGRES_URL) automatically. Locally you can leave this unset — the app
# falls back to an embedded PGlite database stored in .pglite/.
DATABASE_URL=

# --- Auth.js / NextAuth ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local testing)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Vercel Cron protection (REQUIRED in production) ---
# Any random string. Vercel automatically sends it as a Bearer token when
# invoking /api/cron/daily. Production refuses to run the cron without it
# (fail-closed); in development the endpoint stays open.
CRON_SECRET=

# --- Cron dead-man's switch (optional) ---
# A healthchecks.io / Sentry cron-monitor ping URL. The daily cron pings it
# only on SUCCESS, so silence longer than ~26h raises an alert externally.
CRON_PING_URL=

# --- Content-Security-Policy (optional) ---
# The CSP ships report-only by default. Set to 1 to enforce, after a clean
# soak with zero violations across every core flow (see src/middleware.ts).
CSP_ENFORCE=

# --- Invite links ---
# Absolute base URL used when building invite-link URLs. Defaults to the Vercel
# production domain (VERCEL_PROJECT_PRODUCTION_URL), or http://localhost:3000
# in dev, so it can usually stay unset.
APP_URL=

# --- Receipt scanning (vision LLM) ---
# The defaults are FREE OpenRouter models. CAUTION (launch blocker): free
# (":free") models may use your inputs for training, are unreliable, and
# receipts carry card last-4 / loyalty IDs. Before ANY user outside the
# friend group uploads receipts, switch to the paid recipe below — it is
# env-only, no code changes.
#
# PAID RECIPE (recommended, ~half a eurocent per scan):
#   1. Fund an OpenRouter account; in its privacy settings disable
#      "train on inputs" endpoints.
#   2. OPENROUTER_MODEL=google/gemini-2.5-flash-lite   (re-verify the current
#      cheapest adequate tier and run `npx tsx scripts/receipt-eval.ts` first)
#   3. OPENROUTER_FALLBACK_MODEL=openai/gpt-5-mini,anthropic/claude-haiku-4.5
#   4. OPENROUTER_ZDR=true   (zero-data-retention routing)
#   5. Update NEXT_PUBLIC_RECEIPT_LLM_VENDOR + /privacy + docs/ROPA.md if the
#      vendor changed.
# EU-RESIDENCY OPTION: RECEIPT_API_URL=https://eu.api.openai.com/v1/chat/completions
#   with RECEIPT_API_KEY holding an OpenAI key and OPENROUTER_MODEL=gpt-5-mini.
OPENROUTER_API_KEY=
# Honest alias for the key when not on OpenRouter (falls back to the above).
RECEIPT_API_KEY=
# OpenAI-compatible chat-completions endpoint; default is OpenRouter's.
RECEIPT_API_URL=
# Defaults to minimax/minimax-m3:free when unset. Paid (non-":free") models
# also get strict structured outputs automatically.
OPENROUTER_MODEL=
# Comma-separated ladder tried in order when the primary model is
# rate-limited, hangs, or returns unusable output (see DEFAULT_FALLBACK_MODELS
# in receipt-parse.ts for the current defaults when unset).
OPENROUTER_FALLBACK_MODEL=
# "true" restricts OpenRouter routing to zero-data-retention endpoints.
OPENROUTER_ZDR=
# Vendor name shown in the scan-page notice and the privacy policy.
NEXT_PUBLIC_RECEIPT_LLM_VENDOR=

# --- Scan quota (freemium foundation) ---
# Metering always records; the monthly cap refuses scans only when this is 1.
# Leave off until a way to pay exists (see src/lib/entitlements.ts).
SCAN_QUOTA_ENFORCED=

# --- Contact & legal ---
# Shown as the controller contact address on /privacy.
NEXT_PUBLIC_CONTACT_EMAIL=
