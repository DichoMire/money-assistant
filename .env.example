# --- Database (Neon / Vercel Postgres) ---
# On Vercel: add the Neon integration from the Marketplace; it sets DATABASE_URL
# (or POSTGRES_URL) automatically. Locally you can leave this unset — the app
# falls back to an embedded PGlite database stored in .pglite/.
DATABASE_URL=

# --- Auth.js / NextAuth ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local testing)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Vercel Cron protection (optional but recommended) ---
# Any random string. Vercel automatically sends it as a Bearer token when
# invoking /api/cron/daily.
CRON_SECRET=

# --- Invite links ---
# Absolute base URL used when building invite-link URLs. Defaults to the Vercel
# production domain (VERCEL_PROJECT_PRODUCTION_URL), or http://localhost:3000
# in dev, so it can usually stay unset.
APP_URL=
